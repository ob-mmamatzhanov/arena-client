# Адреса игрового сервера. Скопируйте в .env.local и поправьте.
# WebSocket: /ws?mode=<режим> — быстрая игра, /ws?room=<id> — вход в комнату.
VITE_WS_URL=ws://localhost:8080/ws
# HTTP API: /rooms, /rooms/by-code/<код>, /leaderboard.
# Если не задан — берётся хост из VITE_WS_URL.
VITE_API_URL=http://localhost:8080
# Прод:
# VITE_WS_URL=wss://arena-ob.fly.dev/ws
# VITE_API_URL=https://arena-ob.fly.dev
